# Copy to .env.local (git-ignored) and fill in. All VITE_ variables are compiled into the browser bundle,
# so only ever put the PUBLIC Storefront API token here — never an Admin API token or app secret.

# Store domain without protocol, e.g. bahr.myshopify.com
VITE_SHOPIFY_DOMAIN=
# Public Storefront API access token (Shopify admin → Settings → Apps and sales channels → Develop apps,
# or the Headless sales channel). Needs at least: unauthenticated_read_product_listings,
# unauthenticated_read_product_tags, unauthenticated_write_checkouts / unauthenticated_read_checkouts (cart).
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional. Storefront API version (defaults to 2026-10). Keep it within Shopify's supported window.
VITE_SHOPIFY_API_VERSION=
# Optional. Country for prices, availability and checkout (defaults to BH).
VITE_SHOPIFY_COUNTRY=
